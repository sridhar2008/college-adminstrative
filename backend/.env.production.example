# ============================================================
# CSMS Backend – Production Environment Variables
# Copy this file and fill in your actual values.
# NEVER commit a file with real secrets to Git.
# ============================================================

# --- Database ---
# PostgreSQL connection string from Neon / Supabase / Render / Railway
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Security ---
# Generate a strong 256-bit key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET

# --- App ---
ENVIRONMENT=production
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- CORS ---
# Your GitHub Pages frontend URL (comma-separated for multiple)
BACKEND_CORS_ORIGINS=https://sridhar2008.github.io
