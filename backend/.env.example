# Environment Variables Template for CSMS Backend
# Copy to .env and adjust variables for your environment

PROJECT_NAME="College Student Management System (CSMS)"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security
SECRET_KEY="replace_with_a_super_secret_high_entropy_random_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration
# Default local database (SQLite fallback for quick testing without external services):
DATABASE_URL="sqlite:///./csms.db"

# Production Managed PostgreSQL Database URL (Neon, Supabase, AWS RDS, Render Postgres):
# DATABASE_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/csms_db?sslmode=require"

# CORS Origins (Comma separated URLs)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://your-username.github.io"]
